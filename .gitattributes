# Universal Git attributes for consistent line endings and file handling

* text=auto eol=lf

# Documentation
*.md text eol=lf diff=markdown
*.txt text eol=lf

# Configuration
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Source files (common)
*.py text eol=lf diff=python
