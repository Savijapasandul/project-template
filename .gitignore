# Universal .gitignore for framework-agnostic project templates
# Add project-specific entries after creating a repository from this template.

# --- Operating systems ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*~
.directory
.Trash-*

# --- Environment and secrets ---
.env
.env.local
.env.*.local
.envrc
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
*.secret
*.credentials

# Example environment files are intentionally NOT ignored:
# .env.example
# .env.template

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Caches and temporary files ---
.cache/
.tmp/
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*.bak

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
pip-log.txt
pip-delete-this-directory.txt

# --- Node.js / JavaScript / TypeScript ---
node_modules/
jspm_packages/
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
*.tsbuildinfo
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/
.next/
out/
.nuxt/
.svelte-kit/
.vercel/
.netlify/

# --- Build output ---
dist/
build/
target/
*.o
*.a
*.dll
*.exe
*.out

# --- Testing and coverage ---
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/

# --- IDEs and editors ---
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.code-workspace

# --- Package manager lock files (optional — uncomment if desired) ---
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
